{
  "name": "changeradar",
  "version": "0.1.1",
  "description": "Analyze Git changes and highlight deployment-impacting modifications.",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hannhm1109/ChangeRadar.git"
  },
  "homepage": "https://github.com/hannhm1109/ChangeRadar#readme",
  "bugs": {
    "url": "https://github.com/hannhm1109/ChangeRadar/issues"
  },
  "keywords": ["cli", "git", "deployment", "ci", "typescript", "nextjs", "static-analysis"],
  "type": "module",
  "bin": {
    "changeradar": "dist/cli.js"
  },
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "docs/demo.png",
    "scripts/demo.mjs"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "demo": "node scripts/demo.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "check:package": "node scripts/check-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir tests",
    "test:watch": "vitest --dir tests"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/types": "^7.29.8",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
